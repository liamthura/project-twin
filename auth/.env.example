# Better Auth service — copy to .env for local development.
#
# BETTER_AUTH_SECRET must be at least 32 characters (per the installation
# docs). Generate one with:  openssl rand -base64 32
#
# Better Auth also reads BETTER_AUTH_SECRETS (plural, comma-separated) to
# rotate the secret without invalidating existing sessions. Worth knowing
# before the first rotation rather than during one.

BETTER_AUTH_SECRET=

# The PUBLIC origin, not this service address. Set explicitly so Better Auth
# never infers its own URLs from forwarded headers -- FastAPI proxies /auth/*
# here, and an inferred base would put internal addresses in redirects.
BETTER_AUTH_URL=http://localhost:1120

# Same Postgres as the API. The service pins search_path to the better_auth
# schema; the tables themselves are created by Alembic, not by this service.
DATABASE_URL=

# Extra origins allowed to call this service, comma-separated. BETTER_AUTH_URL
# is always trusted; this is for the development case, where the browser is on
# the Vite dev server and so sends a different Origin.
#
# Uncomment this in development. It also gates callbackURL, which the email
# flows all send: adding an email from the dev server without it fails with
# INVALID_CALLBACK_URL, an error that names neither this variable nor the fix.
# In production the SPA and BETTER_AUTH_URL share an origin, so nothing extra
# is needed there.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3100

# Where this service listens, internally. Not published.
# PORT=3001
# HOST=0.0.0.0

# Email (Resend). Unset, the service LOGS reset and verification links to
# stdout instead of sending them -- which is how these flows are tested before
# a Resend account or DNS records exist.
#
# EMAIL_FROM must be on a domain verified in Resend, or delivery fails.
# RESEND_API_KEY=
# EMAIL_FROM=MyGist <noreply@yourdomain>

# Closed testing. `true` gates account creation on an invite code; the codes
# themselves are minted from the API with `python scripts/invite.py`.
#
# Set it on BOTH this service and the API. The boot log reports which mode this
# service is in, and how many codes can currently admit someone -- turning it
# on with none minted locks out everyone including you.
#
# Off by default, which is what every self-hosted instance runs.
# INVITE_ONLY=true

# OAuth for MCP clients. The canonical URI of the MCP endpoint --
# <public origin>/mcp, no trailing slash -- and the same value the API
# container reads under the same name. An audience is an exact string match
# across the two services, so they have to agree character for character.
#
# Set it on BOTH, or on neither. Unset here, this service registers no OAuth
# endpoints at all: no /auth/oauth2/authorize, no /auth/oauth2/token, and in
# particular no /auth/oauth2/register, which accepts unauthenticated client
# registrations. An instance that never asked to be an authorization server
# does not become one.
#
# AUTH_MCP_RESOURCE=https://your-instance/mcp

# ---------------------------------------------------------------------------
# Federated sign-in (optional)
# ---------------------------------------------------------------------------
# Set all three, or none. A discovery URL without credentials refuses to boot.
#
# Unset, this service registers no provider, the SPA shows no button, and
# password sign-in is the only way in -- which is what every self-hosted
# instance runs.
#
# On the identity provider, the redirect URI to register is:
#
#     <your public origin>/auth/callback/authentik
#
# Note: no `oauth2` segment. Better Auth 1.7 serves federated callbacks on its
# core /callback/:providerId route.
#
# Also set AUTH_OIDC_DISCOVERY_URL (the URL only, never the secret) on the API
# container, or the button never appears. See docs/run/self-hosting.
#
# This service fetches the discovery document at startup and will NOT boot while
# it is unreachable. That is deliberate: booting with SSO quietly disabled is
# worse than failing where the deploy log can show why.
#
# AUTH_OIDC_DISCOVERY_URL=https://door.example.com/application/o/mygist/.well-known/openid-configuration
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Trusted proxies (optional)
# ---------------------------------------------------------------------------
# Which addresses in an X-Forwarded-For chain are proxies rather than the
# client, comma-separated, IPs or CIDRs. Empty by default, and empty passes no
# option at all.
#
# LEAVE THIS UNSET for a normal MyGist deployment.
#
# The client address does not arrive here as a chain to walk. The API container
# OVERWRITES X-Forwarded-For with the address it saw connect to it and discards
# whatever the caller sent (backend/auth_proxy.py), so this service receives
# exactly one entry -- and a single entry resolves with nothing configured. That
# is also what makes it unforgeable: the caller's value never survives the hop.
#
# Set it only if something OTHER than the API container fronts this service and
# appends to the header:
#
#   AUTH_TRUSTED_PROXIES=172.18.0.0/16
#
# If what you actually have is an edge proxy in front of the API container, the
# variable you want is FORWARDED_ALLOW_IPS on THAT container -- see
# docs/run/self-hosting. Rate limiting keys on the client IP and /sign-in*
# allows 3 requests per 10 seconds, so an edge proxy the API cannot see past
# puts every visitor in one bucket.
#
# Do NOT set this to the private ranges. It was briefly defaulted to them, and
# that is worse than empty: the walk runs from the right and returns the
# rightmost entry it does not trust, so a caller sending two PUBLIC addresses
# gets their own value back -- a rate-limit bucket of their choosing, and any
# address they like in their session record. auth/src/auth.js has the measured
# cases.
#
# Invalid entries are warned about in the boot log and ignored rather than
# refused, so a typo degrades quietly instead of failing loudly -- read the log
# after changing this.
