# MyGist Frontend Environment Variables
# Copy to .env.local for local development.
#
# You normally need none of these. The app and the API are served from one
# origin (see ./Dockerfile), so getApiBase() falling back to the relative
# "/api" is correct in both development -- where vite.config.js proxies it to
# 127.0.0.1:1120 -- and in production.

# Backend API URL. Only set this when running this UI detached from a MyGist
# server, e.g. pointing a local dev UI at a remote instance. Setting it in a
# production build defeats the same-origin default, so leave it unset there.
# VITE_API_URL=https://your-mygist-server.example.com/api

# Default API token (optional - can also be configured in the UI)
# VITE_API_TOKEN=your-secret-token
