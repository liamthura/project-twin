        "valid_values": {
          "kind": [
            "book",
            "article",
            "podcast",
            "show",
            "film",
            "game",
            "video",
            "music"
          ],
          "status": [
            "want",
            "in_progress",
            "finished",
            "dropped"
          ],
          "reaction": [
            "loved",
            "liked",
            "disliked"
