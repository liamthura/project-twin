        "required": [
          "name"
        ],
        "optional": [
          "domain",
          "stance",
          "notes",
          "references"
        ],
        "valid_values": {
          "domain": [
            "ui",
            "graphic",
            "typography",
            "color",
            "illustration",
            "photography",
            "fashion",
            "interior",
            "general"
          ],
          "stance": [
            "love",
            "like",
            "avoid"
          ]
