      "inventory_spec": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "inventory_item_name",
          "name",
          "value"
        ],
        "optional": [],
        "identifier": "name",
        "parent": "inventory_item_name"
      }
