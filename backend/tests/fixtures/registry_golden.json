            "color",
            "illustration",
            "photography",
            "fashion",
            "interior",
            "general"
          ],
          "stance": [
            "love",
            "like",
            "avoid"
          ]
        },
        "exclusive_fields": [
          "primary"
        ],
        "identifier": "name",
        "list": "styles",
        "field_defaults": {
          "stance": "like"
        }
      }
    },
    "circle": {
      "connection": {
        "actions": [
          "add",
          "update",
          "remove"
