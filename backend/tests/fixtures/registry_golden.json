{
  "always_on_sections": [
    "learning_log",
    "preferences",
    "profile"
  ],
  "entity_schema": {
    "profile": {
      "email": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "address",
          "purpose"
        ],
        "optional": [],
        "identifier": "address"
      },
      "link": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "url",
          "label"
        ],
        "optional": [
          "new_label"
        ],
        "identifier": "label",
        "description": "A profile link. `label` identifies the row, so renaming one on update means sending `new_label`."
      },
      "language": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "name",
          "fluency"
        ],
        "optional": [],
        "valid_values": {
          "fluency": [
            "native",
            "fluent",
            "conversational",
            "basic"
          ]
        },
        "identifier": "name"
      },
      "work_experience": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "company",
          "role",
          "type",
          "period"
        ],
        "optional": [
          "location",
          "description",
          "skills",
          "highlights"
        ],
        "identifier": "company"
      },
      "work_highlight": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "company",
          "highlight"
        ],
        "optional": [],
        "identifier": "highlight",
        "parent": "company"
      },
      "education": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "institution"
        ],
        "optional": [
          "degree_level",
          "field_of_study",
          "start_year",
          "end_year",
          "status",
          "highlights",
          "coursework",
          "clubs"
        ],
        "identifier": "institution"
      },
      "education_highlight": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "institution",
          "highlight"
        ],
        "optional": [],
        "identifier": "highlight",
        "parent": "institution"
      },
      "coursework": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "institution",
          "course"
        ],
        "optional": [
          "topics"
        ],
        "identifier": "course",
        "parent": "institution",
        "description": "A module or class. Stored as {name, topics}; `course` is the input spelling for `name`."
      },
      "coursework_topic": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "institution",
          "course"
        ],
        "optional": [
          "topics"
        ],
        "identifier": "course",
        "parent": "institution",
        "description": "Alias for `coursework` -- same list, same object shape."
      },
      "basic_info": {
        "actions": [
          "update"
        ],
        "required": [],
        "optional": [
          "name",
          "preferred_name",
          "current_role",
          "organisation",
          "location",
          "nationality",
          "bio"
        ],
        "identifier": null,
        "description": "Update-only singleton for top-level profile fields"
      },
      "club": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "institution",
          "name"
        ],
        "optional": [
          "activities_involved"
        ],
        "identifier": "name",
        "parent": "institution",
        "description": "A society or extracurricular. Stored as {name, activities_involved}."
      },
      "work_skill": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "company",
          "skill"
        ],
        "optional": [
          "skills"
        ],
        "identifier": "skill",
        "parent": "company",
        "description": "A skill or technology used in a role. Bare strings on the parent row, like work_highlight."
      }
    },
    "goals": {
      "goal": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "title"
        ],
        "optional": [
          "type",
          "custom_type",
          "status",
          "target_date",
          "why",
          "notes"
        ],
        "valid_values": {
          "type": [
            "career",
            "learning",
            "personal",
            "health",
            "financial",
            "creative",
            "other"
          ],
          "status": [
            "active",
            "achieved",
            "paused",
            "dropped"
          ]
        },
        "identifier": "title"
      }
    },
    "knowledge": {
      "domain": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "name"
        ],
        "optional": [
          "level",
          "notes",
          "references"
        ],
        "valid_values": {
          "level": [
            "beginner",
            "learning",
            "intermediate",
            "advanced",
            "expert"
          ]
        },
        "identifier": "name"
      },
      "domain_reference": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "domain_name",
          "ref_name"
        ],
        "optional": [
          "url",
          "notes"
        ],
        "identifier": "ref_name",
        "parent": "domain_name"
      },
      "knowledge": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "name"
        ],
        "optional": [
          "category",
          "level",
          "notes",
          "references"
        ],
        "description": "Generic knowledge entry with category support",
        "identifier": "name"
      },
      "mental_tab": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "title"
        ],
        "optional": [
          "notes",
          "tags",
          "status",
          "references"
        ],
        "valid_values": {
          "status": [
            "open",
            "closed",
            "archived"
          ]
        },
        "identifier": "title",
        "description": "Saved topics and bookmarks to revisit later \u2014 a shelf, not an inbox"
      },
      "mental_tab_reference": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "title",
          "ref_name"
        ],
        "optional": [
          "url",
          "notes"
        ],
        "identifier": "ref_name",
        "parent": "title"
      }
    },
    "preferences": {
      "like": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "item"
        ],
        "optional": [
          "stance"
        ],
        "valid_values": {
          "stance": [
            "like",
            "dislike"
          ]
        },
        "identifier": "item",
        "list": "likes_dislikes",
        "description": "Something you like; stored in the shared likes_dislikes list with stance=like unless you send stance explicitly"
      },
      "dislike": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "item"
        ],
        "optional": [
          "stance"
        ],
        "valid_values": {
          "stance": [
            "like",
            "dislike"
          ]
        },
        "identifier": "item",
        "list": "likes_dislikes",
        "description": "Something you dislike; stored in the shared likes_dislikes list with stance=dislike unless you send stance explicitly"
      },
      "preference": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "key"
        ],
        "optional": [
          "category",
          "value"
        ],
        "description": "Generic key-value preference with category support",
        "identifier": "key"
      },
      "communication_default": {
        "actions": [
          "update"
        ],
        "required": [],
        "optional": [
          "tone",
          "detail_level",
          "locale"
        ],
        "identifier": null,
        "description": "Update-only singleton for default communication style"
      },
      "mood_override": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "mood"
        ],
        "optional": [
          "tone",
          "detail_level"
        ],
        "identifier": "mood"
      },
      "response_format": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "item"
        ],
        "optional": [],
        "identifier": "item",
        "description": "One statement about how you want answers shaped. Bare strings, like lifestyle's energy_peaks."
      }
    },
    "projects": {
      "project": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "name",
          "description"
        ],
        "optional": [
          "status",
          "tags",
          "notes",
          "highlights",
          "references"
        ],
        "valid_values": {
          "status": [
            "active",
            "paused",
            "completed",
            "archived",
            "idea"
          ]
        },
        "identifier": "name"
      },
      "project_tag": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "project_name",
          "tag"
        ],
        "optional": [],
        "identifier": "tag",
        "parent": "project_name"
      },
      "project_reference": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "project_name",
          "ref_name"
        ],
        "optional": [
          "url",
          "notes"
        ],
        "identifier": "ref_name",
        "parent": "project_name"
      },
      "project_highlight": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "project_name",
          "highlight"
        ],
        "optional": [],
        "identifier": "highlight",
        "parent": "project_name"
      },
      "top_of_mind": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "item"
        ],
        "optional": [
          "note"
        ],
        "identifier": "item",
        "description": "Inbox for fleeting ideas and current thoughts \u2014 expect entries to be pruned"
      }
    },
    "lifestyle": {
      "hobby": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "name"
        ],
        "optional": [
          "skill_level",
          "status",
          "notes",
          "specifics",
          "references"
        ],
        "valid_values": {
          "skill_level": [
            "beginner",
            "learning",
            "intermediate",
            "advanced",
            "expert"
          ],
          "status": [
            "active",
            "inactive",
            "paused"
          ]
        },
        "identifier": "name"
      },
      "hobby_reference": {
        "actions": [
          "add",
          "update",
          "remove"
        ],
        "required": [
          "hobby_name",
          "ref_name"
        ],
        "optional": [
          "url",
          "notes"
        ],
        "identifier": "ref_name",
        "parent": "hobby_name"
      },
      "hobby_specific": {
        "actions": [
          "add",
          "remove"
        ],
        "required": [
          "hobby_name",
          "specific"
