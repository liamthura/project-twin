{
  "$schema": "../meta_schema.json",
  "key": "example",
  "title": "Example",
  "description": "One-line description shown in the Sections manager",
  "core": false,
  "default_enabled": false,
  "position": 100,
  "defaults": {
    "items": []
  },
  "id_lists": [
    [
      "items",
      "example"
    ]
  ],
  "scope_contributions": {
    "personal": [
      "items"
    ]
  },
  "entities": {
    "example_item": {
      "actions": [
        "add",
        "update",
        "remove"
      ],
      "list": "items",
      "required": [
        "name"
      ],
      "optional": [
        "notes",
        "tags"
      ],
      "identifier": "name"
    }
  },
  "ui": {
    "sections": [
      {
        "kind": "list",
        "path": [
          "items"
        ],
        "entity": "example_item",
        "title_field": "name",
        "badges": [],
        "detail_fields": [
          "notes",
          "tags"
        ],
        "suggestions": {
          "name": [
            "Example 1",
            "Example 2",
            "Example 3"
          ]
        }
      }
    ]
  }
}
