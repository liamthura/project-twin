{
  "$schema": "../meta_schema.json",
  "key": "example",
  "title": "Example",
  "description": "One-line description shown in the Sections manager",
  "core": false,
  "default_enabled": false,
  "position": 100,
  "defaults": {
    "items": []
  },
  "id_lists": [
    [
      "items",
      "example"
    ]
  ],
  "scope_contributions": {
    "personal": [
      "items"
    ]
  },
  "sections": [
    {
      "kind": "list",
      "path": [
        "items"
      ],
      "element": {
        "entity": "example_item",
        "identifier": "name",
        "list": "items",
        "fields": [
          {
            "name": "name",
            "required": true,
            "role": "title",
            "suggestions": [
              "Example 1",
              "Example 2",
              "Example 3"
            ]
          },
          {
            "name": "notes"
          },
          {
            "name": "tags"
          }
        ]
      }
    }
  ]
}
