{
  "$schema": "../meta_schema.json",
  "key": "media",
  "title": "Media",
  "description": "Favourites and what you're into right now: taste, not a log",
  "core": false,
  "default_enabled": false,
  "position": 55,
  "defaults": {
    "items": []
  },
  "id_lists": [
    [
      "items",
      "media"
    ]
  ],
  "scope_contributions": {
    "personal": [
      "items"
    ]
  },
  "sections": [
    {
      "kind": "list",
      "path": [
        "items"
      ],
      "element": {
        "entity": "media_item",
        "identifier": "title",
        "list": "items",
        "fields": [
          {
            "name": "title",
            "required": true,
            "role": "title"
          },
          {
            "name": "url"
          },
          {
            "name": "notes"
          },
          {
            "name": "tags",
            "type": "strings"
          },
          {
            "name": "kind",
            "type": "enum",
            "values": [
              "book",
              "article",
              "podcast",
              "show",
              "film",
              "game",
              "video",
              "music"
            ],
            "show": [
              "badge"
            ]
          },
          {
            "name": "status",
            "type": "enum",
            "values": [
              "want",
              "in_progress",
              "finished",
              "dropped"
            ],
            "show": [
              "badge"
            ]
          },
          {
            "name": "reaction",
            "type": "enum",
            "values": [
              "loved",
              "liked",
              "disliked"
            ],
            "show": [
              "badge"
            ]
          }
        ]
      }
    }
  ]
}
