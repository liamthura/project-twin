{
  "$schema": "../meta_schema.json",
  "key": "media",
  "title": "Media",
  "description": "Favourites and what you're into right now: taste, not a log",
  "core": false,
  "position": 55,
  "default_enabled": false,
  "defaults": {
    "items": []
  },
  "id_lists": [
    [
      "items",
      "media"
    ]
  ],
  "scope_contributions": {
    "personal": [
      "items"
    ]
  },
  "entities": {
    "media_item": {
      "actions": [
        "add",
        "update",
        "remove"
      ],
      "required": [
        "title"
      ],
      "optional": [
        "kind",
        "status",
        "reaction",
        "url",
        "notes",
        "tags"
      ],
      "valid_values": {
        "kind": [
          "book",
          "article",
          "podcast",
          "show",
          "film",
          "game",
          "video",
          "music"
        ],
        "status": [
          "want",
          "in_progress",
          "finished",
          "dropped"
        ],
        "reaction": [
          "loved",
          "liked",
          "disliked"
        ]
      },
      "identifier": "title",
      "list": "items"
    }
  },
  "capture_triggers": [
    "reading",
    "watched",
    "listening to",
    "finished playing"
  ],
  "ui": {
    "sections": [
      {
        "kind": "list",
        "path": [
          "items"
        ],
        "entity": "media_item",
        "title_field": "title",
        "badges": [
          "kind",
          "status",
          "reaction"
        ],
        "detail_fields": [
          "url",
          "notes",
          "tags"
        ],
        "array_fields": [
          "tags"
        ]
      }
    ]
  }
}
