{
  "$schema": "../meta_schema.json",
  "key": "learning_log",
  "title": "Learning Log",
  "description": "What you learn, decide, and reflect on",
  "core": true,
  "position": 70,
  "defaults": {
    "entries": []
  },
  "id_lists": [
    [
      "entries",
      "learn"
    ]
  ],
  "scope_contributions": {
    "learning": [
      "entries"
    ]
  },
  "entities": {
    "learning_entry": {
      "actions": [
        "add",
        "update",
        "remove"
      ],
      "required": [
        "topic",
        "details"
      ],
      "optional": [
        "source",
        "tags",
        "conversation_metadata",
        "key_decisions",
        "followup_items",
        "new_topic",
        "related_entries"
      ],
      "identifier": "topic"
    }
  },
  "ui": {
    "sections": [
      {
        "kind": "list",
        "path": [
          "entries"
        ],
        "entity": "learning_entry",
        "title_field": "topic",
        "badges": [
          "source"
        ],
        "detail_fields": [
          "topic",
          "details",
          "source",
          "tags",
          "key_decisions",
          "followup_items"
        ],
        "array_fields": [
          "tags",
          "key_decisions",
          "followup_items"
        ],
        "long_text": [
          "details"
        ],
        "field_defaults": {
          "source": "manual",
          "timestamp": "@now"
        },
        "sort": {
          "field": "timestamp",
          "dir": "desc"
        },
        "searchable": true,
        "display_fields": [
          "timestamp"
        ],
        "display_formats": {
          "timestamp": "datetime"
        },
        "field_placeholders": {
          "details": "What you learned or discussed...",
          "followup_items": "e.g. Read the migration guide",
          "key_decisions": "e.g. Chose Postgres over SQLite",
          "source": "e.g. conversation, article, course",
          "tags": "e.g. design, languages",
          "topic": "e.g. Spanish subjunctive, React hooks"
        }
      }
    ]
  }
}
