{
  "$schema": "../meta_schema.json",
  "key": "learning_log",
  "title": "Learning Log",
  "description": "What you learn, decide, and reflect on",
  "core": true,
  "position": 70,
  "defaults": {
    "entries": []
  },
  "id_lists": [
    [
      "entries",
      "learn"
    ]
  ],
  "scope_contributions": {
    "learning": [
      "entries"
    ]
  },
  "entities": {
    "learning_entry": {
      "actions": [
        "add",
        "update",
        "remove"
      ],
      "required": [
        "topic",
        "details"
      ],
      "optional": [
        "source",
        "tags",
        "conversation_metadata",
        "key_decisions",
        "followup_items",
        "new_topic",
        "related_entries"
      ],
      "identifier": "topic"
    }
  },
  "ui": {
    "sections": [
      {
        "kind": "list",
        "path": [
          "entries"
        ],
        "entity": "learning_entry",
        "title_field": "topic",
        "badges": [
          "source"
        ],
        "detail_fields": [
          "topic",
          "details",
          "source",
          "tags"
        ],
        "array_fields": [
          "tags"
        ],
        "long_text": [
          "details"
        ],
        "field_defaults": {
          "source": "manual",
          "timestamp": "@now"
        },
        "sort": {
          "field": "timestamp",
          "dir": "desc"
        },
        "searchable": true,
        "display_fields": [
          "timestamp"
        ],
        "display_formats": {
          "timestamp": "datetime"
        },
        "field_placeholders": {
          "details": "What you learned or discussed...",
          "source": "e.g. conversation, article, course",
          "tags": "e.g. design, languages",
          "topic": "e.g. Spanish subjunctive, React hooks"
        },
        "children": [
          {
            "kind": "strings",
            "path": [
              "key_decisions"
            ],
            "title": "Key Decisions",
            "item_control": "input",
            "placeholder": "e.g. Chose Postgres over SQLite for the vector index",
            "$comment": "Bare strings on the parent row (server.py learning entry update). item_control:\"input\" for the same reason profile's work `highlights` uses it: these are SENTENCES, and a chip control makes fixing a typo mean deleting and retyping the whole line. They were chips until wave 12."
          },
          {
            "kind": "strings",
            "path": [
              "followup_items"
            ],
            "title": "Follow-up Items",
            "item_control": "input",
            "placeholder": "e.g. Read the migration guide before the next sprint",
            "$comment": "See the key_decisions node above -- same shape, same reasoning."
          }
        ]
      }
    ]
  }
}
