# =============================================================================
# MyGist MCP Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Full reference: https://mygist.thuradev.qzz.io/docs/run/self-hosting

# REQUIRED - Postgres connection string.
# Any reachable Postgres works; pgvector is optional (without it, search runs
# full-text only). Production here is self-hosted Postgres + pgvector; managed
# providers such as Neon or Supabase are equally fine.
# Local tests: postgresql://mygist:mygist@localhost:5433/mygist_test
DATABASE_URL=

# OPTIONAL - Server settings.
# Read only when running `python main.py` directly. The container's CMD passes
# --host/--port to uvicorn explicitly, so these have no effect there.
# PORT=1120
# HOST=0.0.0.0

# OPTIONAL - Embeddings. Leave unset for FTS-only search.
# EMBEDDING_PROVIDER=voyage      # voyage (default) or openai
# VOYAGE_API_KEY=
# EMBEDDING_API_URL=             # openai: any OpenAI-compatible /v1/embeddings
# EMBEDDING_API_KEY=             # openai: omit for local servers
# EMBEDDING_MODEL=voyage-4-lite
# EMBEDDING_DIM=1024             # must match the model's output width

# OPTIONAL - Suggestions in the Promote dialog, from TypeSafe's Jev. Leave the
# key unset and nothing is sent. Set, an observation's note, reason and quote
# go to TypeSafe when Promote is opened on it (backend/routing.py).
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# OPTIONAL - `true` puts the MCP server's logger at DEBUG instead of INFO
# (server.py's logging.basicConfig). Nothing else reads it.
# DEBUG=true

# MCP_TRANSPORT was listed here once and is read nowhere: the commented-out
# branch it belonged to is gone, and transport is HTTP, always.

# OPTIONAL - Closed testing. `true` makes this instance invite-only: account
# creation requires a code minted with `python scripts/invite.py`.
#
# Set it on BOTH this service and the auth service, and check the auth
# service's boot log says "[invite] invite-only ON". Set on only one, a door is
# left open and nothing says so until somebody walks through it.
#
# Off by default, which is what every self-hosted instance runs.
# INVITE_ONLY=true

# OPTIONAL - Email. RESEND_API_KEY and EMAIL_FROM are the auth service's two,
# read here too: by scripts/access.py for invites, and for the owner's copy of
# each feedback report. Unset, mail is printed rather than sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=MyGist <mygist@example.com>
#
# Where feedback from the island is emailed. Unset, reports are saved and not
# emailed; read them with `python scripts/feedback.py`.
# FEEDBACK_TO=you@example.com
