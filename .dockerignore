# MyGist -- exclusions for the root build context (see ./Dockerfile).
#
# Patterns must be explicit about nesting. A bare "venv/" matches only the
# top level, so "**/venv/" is required to keep backend/venv out of the
# context -- likewise "**/.env" for backend/.env, which holds DATABASE_URL
# and any embedding provider key.

# Secrets -- never bake these into an image
**/.env
**/.env.*
!**/.env.example

# Dependencies and build output (both are rebuilt inside the image)
**/node_modules/
**/dist/
**/build/
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.egg-info/

# Dev-only, not needed at runtime
**/.pytest_cache/
**/.cache/
**/coverage/
**/storybook-static
backend/tests/
backend/archive/
backend/docker-compose.yml
backend/Dockerfile
Dockerfile

# Test and story inputs -- unreachable from the app's module graph, so
# excluding them from the build context is harmless, but it keeps editing a
# test or story from invalidating the `COPY frontend/ ./` layer and forcing a
# full image rebuild.
**/.storybook
**/*.stories.jsx
**/vitest.config.js
frontend/src/test
frontend/src/__fixtures__
frontend/scripts
**/test-results

# Repo metadata and docs sources (the built docs site is copied from the
# Node stage, not from the context)
.git/
.github/
.agents/
.claude/
.superpowers/
docs/
mygist_data/
*.md
!README.md
*.log
.DS_Store
